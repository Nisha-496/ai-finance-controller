# Copy to .env and fill in real values. .env is gitignored.

# Local Postgres — run `npx prisma dev -d -n tracefinance` to start one,
# then copy the TCP connection string it prints (use 127.0.0.1, not localhost).
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/tracefinance?sslmode=disable"

# Used from Day 4 (AI explanation + chat layer) — not required for the deterministic core.
OPENAI_API_KEY=""
